# Copy this file to .env and fill in your keys. Never commit .env.

# The chat agent: set ONE of these. If both are set, ChatGPT (OpenAI) is used.
# ChatGPT: get a key at https://platform.openai.com
OPENAI_API_KEY=
# Claude: get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Qloo Taste AI. Request a key from the hackathon page: https://qloo.devpost.com
QLOO_API_KEY=
# Use the base URL Qloo sent with your key.
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Optional
# PORT=3000
# OPENAI_MODEL=gpt-4.1
# RIDETASTE_MODEL=claude-opus-5-5
# Contact email sent to OpenStreetMap's geocoder, as its usage policy asks.
# CONTACT_EMAIL=you@example.com
